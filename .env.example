# Copy to .env and fill in. NEVER commit .env.

# --- Network (dashboard only listens on loopback) ---
HOST=127.0.0.1
# UI port (open http://localhost:8001)
PORT=8001
# Internal backend port used in dev mode (Vite proxies to it)
API_PORT=8002

# --- RPC (Helius) ---
RPC_PRIMARY_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
RPC_PRIMARY_WS=wss://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
# Fallback RPC, used when the primary fails (e.g. a second provider)
RPC_FALLBACK_URL=
RPC_FALLBACK_WS=
RPC_PRIMARY_COOLDOWN_MS=60000
RPC_TIMEOUT_MS=15000

# --- Keystore: encrypts all private keys in data/keystore.enc ---
# Min. 12 characters. If you lose it, the keys in the keystore are lost.
KEYSTORE_PASSWORD=
KEYSTORE_PATH=data/keystore.enc
DB_PATH=data/konda.db

# --- Dashboard login ---
# Generate with: pnpm hash-password
DASHBOARD_PASSWORD_HASH=
SESSION_TTL_HOURS=12
